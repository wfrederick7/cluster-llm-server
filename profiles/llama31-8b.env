# Eight independent Llama 3.1 8B replicas, one per H100. The default revision
# is the model repository's published SHA; override after validating a newer one.
MODEL_ID="meta-llama/Llama-3.1-8B-Instruct"
MODEL_REVISION="${MODEL_REVISION:-0e9e39f249a16976918f6564b8830bc894c89659}"
SERVED_MODEL_NAME="meta-llama/Llama-3.1-8B-Instruct"
PORT="${PORT:-8000}"
REPLICA_BASE_PORT="${REPLICA_BASE_PORT:-8100}"
REPLICA_COUNT="8"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-64}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-32768}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.88}"
DTYPE="auto"
KV_CACHE_DTYPE="auto"
MIN_FREE_GB="40"
PROXY_MAX_IN_FLIGHT_PER_BACKEND="${PROXY_MAX_IN_FLIGHT_PER_BACKEND:-16}"
